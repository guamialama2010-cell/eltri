# 🔐 Configuración de ELTRI

# ========================
# SERVIDOR
# ========================

# Puerto donde corre el servidor
PORT=5000

# Ambiente
NODE_ENV=development

# ========================
# AUTENTICACIÓN
# ========================

# Secreto para JWT - CAMBIAR EN PRODUCCIÓN
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_secreto_super_seguro_aqui_cambiar_en_produccion

# Tiempo de expiración de token (en horas)
JWT_EXPIRY=168

# ========================
# BASE DE DATOS
# ========================

# SQLite (desarrollo)
DB_PATH=./data/eltri.db

# PostgreSQL (producción) - Descomentar si usas PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_contraseña
# DB_NAME=eltri

# ========================
# IA - ASISTENTE EDUCATIVO
# ========================

# OpenAI (ChatGPT)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-sonnet

# Google (Gemini)
# GOOGLE_API_KEY=AIzaSy...
# GOOGLE_MODEL=gemini-pro

# ========================
# FRONTEND
# ========================

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# ========================
# EMAIL (Futuro)
# ========================

# Para notificaciones y recuperación de contraseña
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=tu_contraseña_app

# ========================
# LOGGING
# ========================

# Nivel de logs: debug, info, warn, error
LOG_LEVEL=info

# ========================
# DESARROLLO
# ========================

# Mostrar SQL queries
DEBUG_SQL=false

# Mostrar errores detallados
DEBUG_ERRORS=true
